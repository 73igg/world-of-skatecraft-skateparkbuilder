+++ b/src/game/Skatecraft.cpp
@@ -0,0 +1,434 @@
+#include "Skatecraft.h"
+#include "SkateFlag.h"
+#include "ParkObjects.h"
+#include "Database/DBCStores.h"
+#include "Chat.h"
+#include "Player.h"
+#include "SpellMgr.h"
+#include "Timer.h"
+#include "WorldSession.h"
+#include "ObjectMgr.h"
+
+#include <cstdlib>
+#include <limits>
+#include <unordered_map>
+
+extern SkillRaceClassInfoMap SkillRaceClassInfoBySkill;
+
+namespace Skatecraft
+{
+    // SpellIcon.dbc
+    constexpr uint32 ICON_MECHASTRIDER = 1240;
+    constexpr uint32 ICON_BOOTS        = 230;
+    constexpr uint32 ICON_FLARE        = 136;
+    constexpr uint32 ICON_SPRINT       = 516;
+    constexpr uint32 ICON_MOONGLOW     = 46;
+    constexpr uint32 ICON_ARROW_UP     = 60006;
+    constexpr uint32 ICON_ARROW_DOWN   = 60007;
+    constexpr uint32 ICON_CAMERA       = 60010;
+
+    // A skill tier of one 300 step, so the skill keeps its own max rather than following level.
+    constexpr uint32 SKILL_TIER_300 = 181;
+    constexpr uint32 SKILL_CATEGORY_SECONDARY = 9;
+
+    // Lines closer together than this are not counted (ms).
+    constexpr uint32 LINE_INTERVAL = 1000;
+    // A reported line is clamped to this many points.
+    constexpr float MAX_LINE_POINTS = 100000.f;
+
+    constexpr uint32 ABILITIES[] = {
+        SPELL_SUMMON_SKATEBOARD, SPELL_OLLIE_BOOST, SPELL_ROCKET_BOOST,
+        SPELL_SPEED_DEMON, SPELL_MOON_JUMP, SPELL_SPEED_UP, SPELL_SPEED_DOWN,
+        SPELL_CAMERA_DISTANCE_UP, SPELL_CAMERA_DISTANCE_DOWN, SPELL_CAMERA_PRESET, SPELL_PARK_BUILDER,
+    };
+    constexpr uint16 DEFAULT_CAMERA_STEPS = 8; // half steps: 4.0 times engine framing
+    constexpr uint16 DEFAULT_SPEED_STEPS = 3; // half steps: 1.5 times stock
+    constexpr float SPEED_DEMON_MULTIPLIER = 1.6f;
+    constexpr float STOCK_PUSH_SPEED = 8.5f; // m/s from Skate 3's physics_push/MaxPushableSpeed
+
+    static char s_skillName[] = "Skateboarding";
+    static char s_empty[] = "";
+    static SkillLineEntry s_skillLine;
+    static SkillRaceClassInfoEntry s_raceClass;
+
+    static std::unordered_map<uint32, uint32> s_lastLine; // player guid low -> ms
+    static std::unordered_map<uint32, uint16> s_speedSteps;
+    static bool s_speedStorageReady = false;
+    static std::unordered_map<uint32, uint16> s_cameraSteps;
+    static bool s_cameraStorageReady = false;
+    static std::unordered_map<uint32, uint8> s_cameraPresets;
+    static bool s_presetStorageReady = false;
+
+    void LoadSkillLine()
+    {
+        s_skillLine.id = SKILL_SKATEBOARDING;
+        s_skillLine.categoryId = SKILL_CATEGORY_SECONDARY;
+        for (auto& name : s_skillLine.name)
+            name = s_empty;
+        s_skillLine.name[0] = s_skillName;
+        s_skillLine.spellIcon = ICON_MECHASTRIDER;
+        if (sSkillLineStore.LookupEntry(SKILL_SKATEBOARDING) || !sSkillLineStore.InsertEntry(SKILL_SKATEBOARDING, &s_skillLine))
+        {
+            sLog.Out(LOG_BASIC, LOG_LVL_ERROR, "Skatecraft: skill line %u is taken or out of range; skateboarding is off.", SKILL_SKATEBOARDING);
+            return;
+        }
+
+        s_raceClass.skillId = SKILL_SKATEBOARDING;
+        s_raceClass.raceMask = 0;
+        s_raceClass.classMask = 0;
+        s_raceClass.flags = 0;
+        s_raceClass.reqLevel = 0;
+        s_raceClass.skillTierId = SKILL_TIER_300;
+        SkillRaceClassInfoBySkill.insert(SkillRaceClassInfoMap::value_type(SKILL_SKATEBOARDING, &s_raceClass));
+    }
+
+    static void AddSpell(uint32 id, char const* name, uint32 icon, uint32 castTimeIndex, uint32 durationIndex, uint32 cooldown, bool aura)
+    {
+        SpellEntry* spell = sSpellMgr.AddCustomSpell(id);
+        spell->Custom |= SPELL_CUSTOM_POSITIVE; // a buff we may cancel, not a debuff
+        spell->SpellName[0] = name;
+        spell->SpellIconID = icon;
+        spell->activeIconID = icon;
+        spell->CastingTimeIndex = castTimeIndex;
+        spell->DurationIndex = durationIndex;
+        spell->RecoveryTime = cooldown;
+        spell->StartRecoveryCategory = 133; // the global cooldown
+        spell->StartRecoveryTime = 1500;
+        spell->rangeIndex = 1;              // self
+        spell->baseLevel = 1;
+        spell->spellLevel = 1;
+        spell->InterruptFlags = castTimeIndex > 1 ? 0x0F : 0;
+        spell->Effect[EFFECT_INDEX_0] = aura ? SPELL_EFFECT_APPLY_AURA : SPELL_EFFECT_DUMMY;
+        spell->EffectApplyAuraName[EFFECT_INDEX_0] = aura ? SPELL_AURA_DUMMY : 0;
+        spell->EffectImplicitTargetA[EFFECT_INDEX_0] = TARGET_UNIT_CASTER;
+        spell->EffectDieSides[EFFECT_INDEX_0] = 1;
+        spell->DmgMultiplier[EFFECT_INDEX_0] = 1.f;
+    }
+
+    void LoadSpells()
+    {
+        SkateFlag::InitializeStorage();
+        // SpellCastTimes.dbc: 1 instant, 16 1.5 s. SpellDuration.dbc: 21 until cancelled, 2 30 s, 18 20 s, 36 1 s.
+        AddSpell(SPELL_SUMMON_SKATEBOARD, "Summon Skateboard", ICON_MECHASTRIDER, 16, 21, 0, true);
+        AddSpell(SPELL_OLLIE_BOOST, "Ollie Boost", ICON_BOOTS, 1, 2, 2 * MINUTE * IN_MILLISECONDS, true);
+        AddSpell(SPELL_ROCKET_BOOST, "Rocket Boost", ICON_FLARE, 1, 36, 30 * IN_MILLISECONDS, true);
+        AddSpell(SPELL_SPEED_DEMON, "Speed Demon", ICON_SPRINT, 1, 2, 3 * MINUTE * IN_MILLISECONDS, true);
+        AddSpell(SPELL_MOON_JUMP, "Moon Jump", ICON_MOONGLOW, 1, 18, 5 * MINUTE * IN_MILLISECONDS, true);
+        AddSpell(SPELL_SPEED_UP, "Increase Skate Speed", ICON_ARROW_UP, 1, 0, 0, false);
+        AddSpell(SPELL_SPEED_DOWN, "Decrease Skate Speed", ICON_ARROW_DOWN, 1, 0, 0, false);
+        AddSpell(SPELL_CAMERA_DISTANCE_UP, "Increase Skate Camera Distance", ICON_ARROW_UP, 1, 0, 0, false);
+        AddSpell(SPELL_CAMERA_DISTANCE_DOWN, "Decrease Skate Camera Distance", ICON_ARROW_DOWN, 1, 0, 0, false);
+        AddSpell(SPELL_CAMERA_PRESET, "Cycle Skate Camera Preset", ICON_CAMERA, 1, 0, 0, false);
+        AddSpell(SPELL_PARK_BUILDER, "Park Builder", ICON_CAMERA, 1, 0, 0, false);
+        for (uint32 id : {SPELL_SPEED_UP, SPELL_SPEED_DOWN, SPELL_CAMERA_DISTANCE_UP, SPELL_CAMERA_DISTANCE_DOWN, SPELL_CAMERA_PRESET, SPELL_PARK_BUILDER})
+        {
+            SpellEntry* spell = const_cast<SpellEntry*>(sSpellMgr.GetSpellEntry(id));
+            spell->StartRecoveryCategory = 0;
+            spell->StartRecoveryTime = 0;
+        }
+        // The selected skate speed is a character preference, separate from WoW movement speed.
+        s_speedStorageReady = CharacterDatabase.DirectExecute(
+            "CREATE TABLE IF NOT EXISTS character_skatecraft_speed ("
+            "guid INT UNSIGNED NOT NULL PRIMARY KEY, "
+            "half_steps SMALLINT UNSIGNED NOT NULL DEFAULT 3)");
+        if (!s_speedStorageReady)
+            sLog.Out(LOG_BASIC, LOG_LVL_ERROR, "Skatecraft: unable to create skate speed preference storage.");
+        s_cameraStorageReady = CharacterDatabase.DirectExecute(
+            "CREATE TABLE IF NOT EXISTS character_skatecraft_camera ("
+            "guid INT UNSIGNED NOT NULL PRIMARY KEY, "
+            "half_steps SMALLINT UNSIGNED NOT NULL DEFAULT 8)");
+        if (!s_cameraStorageReady)
+            sLog.Out(LOG_BASIC, LOG_LVL_ERROR, "Skatecraft: unable to create skate camera preference storage.");
+        s_presetStorageReady = CharacterDatabase.DirectExecute(
+            "CREATE TABLE IF NOT EXISTS character_skatecraft_camera_preset ("
+            "guid INT UNSIGNED NOT NULL PRIMARY KEY, "
+            "preset TINYINT UNSIGNED NOT NULL DEFAULT 1)");
+        if (!s_presetStorageReady)
+            sLog.Out(LOG_BASIC, LOG_LVL_ERROR, "Skatecraft: unable to create camera preset preference storage.");
+    }
+
+    void AddDefaultSpells(PlayerInfo& info)
+    {
+        for (uint32 spell : ABILITIES)
+            if (std::find(info.spell.begin(), info.spell.end(), spell) == info.spell.end())
+                info.spell.push_back(spell);
+    }
+
+    void InitializePlayer(Player* player)
+    {
+        if (!sSkillLineStore.LookupEntry(SKILL_SKATEBOARDING))
+            return;
+        if (!player->HasSkill(SKILL_SKATEBOARDING))
+            player->SetSkill(SKILL_SKATEBOARDING, 1, SKILL_MAX);
+        for (uint32 spell : ABILITIES)
+            if (!player->HasSpell(spell))
+                player->LearnSpell(spell, false);
+    }
+
+    static uint16 LoadSpeed(Player* player)
+    {
+        uint16 steps = DEFAULT_SPEED_STEPS;
+        if (s_speedStorageReady)
+            if (auto result = CharacterDatabase.PQuery(
+                "SELECT half_steps FROM character_skatecraft_speed WHERE guid = %u", player->GetGUIDLow()))
+                steps = std::max<uint16>(1, result->Fetch()[0].GetUInt16());
+        s_speedSteps[player->GetGUIDLow()] = steps;
+        return steps;
+    }
+
+    static uint16 SpeedSteps(Player* player)
+    {
+        auto found = s_speedSteps.find(player->GetGUIDLow());
+        return found == s_speedSteps.end() ? LoadSpeed(player) : found->second;
+    }
+
+    static void SendSpeed(Player* player, bool announce)
+    {
+        uint16 steps = SpeedSteps(player);
+        std::string setting = "SKATECRAFT\tS\t" + std::to_string(steps);
+        WorldPacket packet;
+        ChatHandler::BuildChatPacket(packet, CHAT_MSG_WHISPER, setting.c_str(), LANG_ADDON,
+            CHAT_TAG_NONE, player->GetObjectGuid(), nullptr, player->GetObjectGuid());
+        player->GetSession()->SendPacket(&packet);
+        if (announce)
+        {
+            float selected = steps * 0.5f;
+            bool demon = player->HasAura(SPELL_SPEED_DEMON);
+            float effective = selected * (demon ? SPEED_DEMON_MULTIPLIER : 1.f);
+            ChatHandler(player).PSendSysMessage(
+                "Skate speed: %.1fx selected%s; %.1fx effective (%.1f mph / %.1f km/h push limit).",
+                selected, demon ? " + Speed Demon" : "", effective,
+                STOCK_PUSH_SPEED * effective * 2.2369363f, STOCK_PUSH_SPEED * effective * 3.6f);
+        }
+    }
+
+    static uint16 LoadCamera(Player* player)
+    {
+        uint16 steps = DEFAULT_CAMERA_STEPS;
+        if (s_cameraStorageReady)
+            if (auto result = CharacterDatabase.PQuery(
+                "SELECT half_steps FROM character_skatecraft_camera WHERE guid = %u", player->GetGUIDLow()))
+                steps = std::max<uint16>(1, result->Fetch()[0].GetUInt16());
+        s_cameraSteps[player->GetGUIDLow()] = steps;
+        return steps;
+    }
+
+    static uint16 CameraSteps(Player* player)
+    {
+        auto found = s_cameraSteps.find(player->GetGUIDLow());
+        return found == s_cameraSteps.end() ? LoadCamera(player) : found->second;
+    }
+
+    static void SendCamera(Player* player, bool announce)
+    {
+        uint16 steps = CameraSteps(player);
+        std::string setting = "SKATECRAFT\tC\t" + std::to_string(steps);
+        WorldPacket packet;
+        ChatHandler::BuildChatPacket(packet, CHAT_MSG_WHISPER, setting.c_str(), LANG_ADDON,
+            CHAT_TAG_NONE, player->GetObjectGuid(), nullptr, player->GetObjectGuid());
+        player->GetSession()->SendPacket(&packet);
+        if (announce)
+            ChatHandler(player).PSendSysMessage("Skate camera distance: %.1fx (engine framing).", steps * 0.5f);
+    }
+
+    static void AdjustCamera(Player* player, uint32 spell)
+    {
+        uint16 before = CameraSteps(player);
+        uint16 after = before;
+        if (spell == SPELL_CAMERA_DISTANCE_UP && before < std::numeric_limits<uint16>::max())
+            ++after;
+        else if (spell == SPELL_CAMERA_DISTANCE_DOWN && before > 1)
+            --after;
+        if (after != before)
+        {
+            if (!s_cameraStorageReady || !CharacterDatabase.DirectPExecute(
+                "INSERT INTO character_skatecraft_camera (guid, half_steps) VALUES (%u, %u) "
+                "ON DUPLICATE KEY UPDATE half_steps = VALUES(half_steps)", player->GetGUIDLow(), uint32(after)))
+            {
+                ChatHandler(player).SendSysMessage("Your skate camera distance could not be saved. Try again.");
+                return;
+            }
+            s_cameraSteps[player->GetGUIDLow()] = after;
+        }
+        SendCamera(player, true);
+    }
+
+    static uint8 LoadPreset(Player* player)
+    {
+        uint8 preset = 1; // native High; native Low is zero
+        if (s_presetStorageReady)
+            if (auto result = CharacterDatabase.PQuery(
+                "SELECT preset FROM character_skatecraft_camera_preset WHERE guid = %u", player->GetGUIDLow()))
+                preset = result->Fetch()[0].GetUInt8() == 0 ? 0 : 1;
+        s_cameraPresets[player->GetGUIDLow()] = preset;
+        return preset;
+    }
+
+    static uint8 Preset(Player* player)
+    {
+        auto found = s_cameraPresets.find(player->GetGUIDLow());
+        return found == s_cameraPresets.end() ? LoadPreset(player) : found->second;
+    }
+
+    static void SendPreset(Player* player, bool announce)
+    {
+        uint8 preset = Preset(player);
+        std::string setting = "SKATECRAFT\tP\t" + std::to_string(uint32(preset));
+        WorldPacket packet;
+        ChatHandler::BuildChatPacket(packet, CHAT_MSG_WHISPER, setting.c_str(), LANG_ADDON,
+            CHAT_TAG_NONE, player->GetObjectGuid(), nullptr, player->GetObjectGuid());
+        player->GetSession()->SendPacket(&packet);
+        if (announce)
+            ChatHandler(player).PSendSysMessage("Skate camera preset: %s.", preset == 0 ? "Low" : "High");
+    }
+
+    static void CyclePreset(Player* player)
+    {
+        uint8 next = Preset(player) == 0 ? 1 : 0;
+        if (!s_presetStorageReady || !CharacterDatabase.DirectPExecute(
+            "INSERT INTO character_skatecraft_camera_preset (guid, preset) VALUES (%u, %u) "
+            "ON DUPLICATE KEY UPDATE preset = VALUES(preset)", player->GetGUIDLow(), uint32(next)))
+        {
+            ChatHandler(player).SendSysMessage("Your skate camera preset could not be saved. Try again.");
+            return;
+        }
+        s_cameraPresets[player->GetGUIDLow()] = next;
+        SendPreset(player, true);
+    }
+
+    void OnLogin(Player* player)
+    {
+        InitializePlayer(player);
+        LoadSpeed(player);
+        SendSpeed(player, false);
+        LoadCamera(player);
+        SendCamera(player, false);
+        LoadPreset(player);
+        SendPreset(player, false);
+        SkateFlag::OnLogin(player);
+        ParkObjects::Advertise(player);
+    }
+
+    void OnSpellCast(Player* player, uint32 spell)
+    {
+        if (spell == SPELL_PARK_BUILDER) { ParkObjects::Toggle(player); return; }
+        if (spell == SPELL_CAMERA_PRESET)
+        {
+            CyclePreset(player);
+            return;
+        }
+        if (spell == SPELL_CAMERA_DISTANCE_UP || spell == SPELL_CAMERA_DISTANCE_DOWN)
+        {
+            AdjustCamera(player, spell);
+            return;
+        }
+        if (spell != SPELL_SPEED_UP && spell != SPELL_SPEED_DOWN &&
+            spell != SPELL_SPEED_DEMON && spell != SPELL_ROCKET_BOOST)
+            return;
+        uint16 before = SpeedSteps(player);
+        uint16 after = before;
+        if (spell == SPELL_SPEED_UP && before < std::numeric_limits<uint16>::max())
+            ++after;
+        else if (spell == SPELL_SPEED_DOWN && before > 1)
+            --after;
+        if (after != before)
+        {
+            if (!s_speedStorageReady || !CharacterDatabase.DirectPExecute(
+                "INSERT INTO character_skatecraft_speed (guid, half_steps) VALUES (%u, %u) "
+                "ON DUPLICATE KEY UPDATE half_steps = VALUES(half_steps)", player->GetGUIDLow(), uint32(after)))
+            {
+                ChatHandler(player).SendSysMessage("Your skate speed could not be saved. Try again.");
+                return;
+            }
+            s_speedSteps[player->GetGUIDLow()] = after;
+        }
+        SendSpeed(player, true);
+    }
+
+    void OnDelete(uint32 guid)
+    {
+        SkateFlag::OnDelete(guid);
+        if (s_speedStorageReady)
+            CharacterDatabase.PExecute("DELETE FROM character_skatecraft_speed WHERE guid = %u", guid);
+        if (s_cameraStorageReady)
+            CharacterDatabase.PExecute("DELETE FROM character_skatecraft_camera WHERE guid = %u", guid);
+        if (s_presetStorageReady)
+            CharacterDatabase.PExecute("DELETE FROM character_skatecraft_camera_preset WHERE guid = %u", guid);
+        s_cameraPresets.erase(guid);
+        s_cameraSteps.erase(guid);
+        s_speedSteps.erase(guid);
+        s_lastLine.erase(guid);
+    }
+
+    // Points a line needs to raise the skill at `skill`.
+    static float PointsNeeded(uint32 skill)
+    {
+        return 50.f + 5.f * skill;
+    }
+
+    static void LandLine(Player* player, float points)
+    {
+        if (!player->HasSkill(SKILL_SKATEBOARDING) || !player->HasAura(SPELL_SUMMON_SKATEBOARD))
+            return;
+
+        uint32 now = WorldTimer::getMSTime();
+        uint32& last = s_lastLine[player->GetGUIDLow()];
+        if (last && WorldTimer::getMSTimeDiff(last, now) < LINE_INTERVAL)
+            return;
+        last = now;
+
+        points = std::min(points, MAX_LINE_POINTS);
+        uint32 skill = player->GetSkillValueBase(SKILL_SKATEBOARDING);
+        float ratio = points / PointsNeeded(skill);
+
+        // A line worth the skill raises it by one, a bigger one by up to five.
+        uint32 gain = ratio >= 8.f ? 5 : ratio >= 4.f ? 3 : ratio >= 2.f ? 2 : ratio >= 1.f ? 1 : 0;
+        if (gain && skill < SKILL_MAX)
+        {
+            player->SetSkill(SKILL_SKATEBOARDING, std::min(skill + gain, SKILL_MAX), SKILL_MAX);
+        }
+
+        // Character XP: a same-level kill for a line worth the skill, up to four for a big one.
+        uint32 kill = 45 + 5 * player->GetLevel();
+        uint32 xp = uint32(kill * std::min(ratio, 4.f));
+        if (xp)
+            player->GiveXP(xp, nullptr);
+    }
+
+    bool HandleAddonMessage(Player* player, std::string const& message)
+    {
+        if (SkateFlag::Handle(player, message)) return true;
+        static std::string const prefix = "SKATECRAFT\t";
+        if (message.compare(0, prefix.size(), prefix) != 0)
+            return false;
+        std::string body = message.substr(prefix.size());
+        if (body.compare(0, 2, "L\t") == 0)
+        {
+            float points = float(std::atof(body.c_str() + 2));
+            if (points > 0.f)
+                LandLine(player, points);
+        }
+        return true;
+    }
+
+    SpellCastResult CheckCast(Unit const* caster, SpellEntry const* spell)
+    {
+        switch (spell->Id)
+        {
+            case SPELL_SUMMON_SKATEBOARD:
+                if (caster->IsMounted())
+                    return SPELL_FAILED_NOT_MOUNTED;
+                if (caster->IsInCombat())
+                    return SPELL_FAILED_AFFECTING_COMBAT;
+                break;
+            case SPELL_OLLIE_BOOST:
+            case SPELL_ROCKET_BOOST:
+            case SPELL_SPEED_DEMON:
+            case SPELL_MOON_JUMP:
+                if (!caster->HasAura(SPELL_SUMMON_SKATEBOARD))
+                    return SPELL_FAILED_ONLY_MOUNTED;
+                break;
+        }
+        return SPELL_CAST_OK;
+    }
+}
diff --git a/src/game/Skatecraft.h b/src/game/Skatecraft.h
new file mode 100644
index 00000000..31193a32
--- /dev/null
+++ b/src/game/Skatecraft.h
@@ -0,0 +1,59 @@
+/*
+ * World of Skatecraft: Skateboarding, a secondary profession levelled by landing skate lines.
+ *
+ * The benilla client rides the Skate 3 engine and reports each landed line to us as an addon
+ * message ("SKATECRAFT\tL\t<points>"). We raise the Skateboarding skill, give character XP and
+ * teach all skate abilities at character creation and login. Speed and camera distance are saved per
+ * character; the skill line and spells live in code, without editing the game's DBC files.
+ */
+
+#ifndef SKATECRAFT_H
+#define SKATECRAFT_H
+
+#include "Common.h"
+#include "SpellDefines.h"
+
+class Player;
+class Unit;
+class SpellEntry;
+struct PlayerInfo;
+
+namespace Skatecraft
+{
+    constexpr uint32 SKILL_SKATEBOARDING = 760;
+    constexpr uint32 SKILL_MAX = 300;
+
+    // Spell ids stay below 65536: SMSG_INITIAL_SPELLS carries them as uint16.
+    constexpr uint32 SPELL_SUMMON_SKATEBOARD = 60001; // the ride itself, an aura while on the board
+    constexpr uint32 SPELL_OLLIE_BOOST       = 60002;
+    constexpr uint32 SPELL_ROCKET_BOOST      = 60003;
+    constexpr uint32 SPELL_SPEED_DEMON       = 60004;
+    constexpr uint32 SPELL_MOON_JUMP         = 60005;
+    constexpr uint32 SPELL_SPEED_UP          = 60006;
+    constexpr uint32 SPELL_SPEED_DOWN        = 60007;
+    constexpr uint32 SPELL_CAMERA_DISTANCE_UP   = 60008;
+    constexpr uint32 SPELL_CAMERA_DISTANCE_DOWN = 60009;
+    constexpr uint32 SPELL_CAMERA_PRESET        = 60010;
+    constexpr uint32 SPELL_PARK_BUILDER         = 60011;
+
+    // After the DBC stores load: the Skateboarding skill line and its race/class rule.
+    void LoadSkillLine();
+    // After spell_template loads: the skate spells.
+    void LoadSpells();
+    // Every legal race/class starts with the skate abilities alongside its stock spells.
+    void AddDefaultSpells(PlayerInfo& info);
+    // At character creation and login: everyone knows every skate ability.
+    void InitializePlayer(Player* player);
+    // On login: teach missing abilities and restore speed and camera distance.
+    void OnLogin(Player* player);
+    // A successfully completed cast: speed and camera steps and status notices.
+    void OnSpellCast(Player* player, uint32 spell);
+    // Remove this preference when a character is permanently deleted.
+    void OnDelete(uint32 guid);
+    // An addon message from the client; true when it was ours.
+    bool HandleAddonMessage(Player* player, std::string const& message);
+    // Extra cast checks for the skate spells; SPELL_CAST_OK otherwise.
+    SpellCastResult CheckCast(Unit const* caster, SpellEntry const* spell);
+}
+
+#endif
