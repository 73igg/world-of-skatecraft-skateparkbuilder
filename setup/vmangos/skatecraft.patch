diff --git a/src/game/SkateFlagCore.h b/src/game/SkateFlagCore.h
new file mode 100644
index 00000000..5cf72d34
--- /dev/null
+++ b/src/game/SkateFlagCore.h
@@ -0,0 +1,66 @@
+#ifndef SKATE_FLAG_CORE_H
+#define SKATE_FLAG_CORE_H
+#include <array>
+#include <cmath>
+#include <cstdint>
+#include <cstdlib>
+#include <iomanip>
+#include <limits>
+#include <sstream>
+#include <string>
+#include <vector>
+
+namespace SkateFlagCore
+{
+    constexpr char PREFIX[] = "SKATEFLAG\t1\t";
+    struct Flag {
+        uint64_t revision=0;
+        uint32_t map=0,instance=0,zone=0;
+        std::array<float,3> position{};
+        float facing=0;
+    };
+    struct Request {
+        char kind=0;
+        uint32_t request=0;
+        uint64_t revision=0;
+        std::array<float,3> position{};
+        float facing=0;
+    };
+    inline bool Unsigned(std::string const& text,uint64_t maximum,uint64_t& out) {
+        if(text.empty())return false;
+        out=0;
+        for(char c:text) { if(c<'0'||c>'9'||out>(maximum-uint64_t(c-'0'))/10)return false;out=out*10+uint64_t(c-'0'); }
+        return true;
+    }
+    inline bool Number(std::string const& text,float& out) {
+        if(text.empty())return false;
+        for(char c:text)if(!((c>='0'&&c<='9')||c=='+'||c=='-'||c=='.'||c=='e'||c=='E'))return false;
+        char* end=nullptr;out=std::strtof(text.c_str(),&end);
+        return end==text.c_str()+text.size()&&std::isfinite(out);
+    }
+    inline bool Valid(Flag const& f) {
+        return f.revision&&std::isfinite(f.facing)&&f.facing>=0&&f.facing<6.28318530718f
+            &&std::isfinite(f.position[0])&&std::isfinite(f.position[1])&&std::isfinite(f.position[2]);
+    }
+    inline bool Decode(std::string const& message,Request& out) {
+        if(message.size()>255||message.compare(0,sizeof(PREFIX)-1,PREFIX)!=0)return false;
+        std::vector<std::string> fields;std::string body=message.substr(sizeof(PREFIX)-1);
+        size_t start=0;
+        for(size_t i=0;i<=body.size();++i)if(i==body.size()||body[i]=='\t') {fields.push_back(body.substr(start,i-start));start=i+1;}
+        out=Request{};
+        if(fields.size()==1&&fields[0]=="H") {out.kind='H';return true;}
+        uint64_t n=0;
+        if(fields.size()<2||!Unsigned(fields[1],UINT32_MAX,n)||!n)return false;
+        out.request=uint32_t(n);
+        if(fields.size()==3&&fields[0]=="R"&&Unsigned(fields[2],UINT64_MAX,out.revision)) {out.kind='R';return true;}
+        if(fields.size()==6&&fields[0]=="S"&&Number(fields[2],out.position[0])&&Number(fields[3],out.position[1])
+            &&Number(fields[4],out.position[2])&&Number(fields[5],out.facing)&&out.facing>=0&&out.facing<6.28318530718f) {out.kind='S';return true;}
+        return false;
+    }
+    inline std::string Fields(Flag const& f) {
+        std::ostringstream s;s.imbue(std::locale::classic());s<<std::setprecision(std::numeric_limits<float>::max_digits10)
+            <<f.revision<<'\t'<<f.map<<'\t'<<f.instance<<'\t'<<f.zone<<'\t'<<f.position[0]<<'\t'<<f.position[1]<<'\t'<<f.position[2]<<'\t'<<f.facing;
+        return s.str();
+    }
+}
+#endif
diff --git a/src/game/Skatecraft.cpp b/src/game/Skatecraft.cpp
