diff --git a/src/game/ParkObjects.cpp b/src/game/ParkObjects.cpp
new file mode 100644
index 00000000..98e1eca5
--- /dev/null
+++ b/src/game/ParkObjects.cpp
@@ -0,0 +1,134 @@
+#include "ParkObjects.h"
+#include "ParkObjectsCore.h"
+#include "Player.h"
+#include "WorldSession.h"
+#include "World.h"
+#include "Chat.h"
+#include "Timer.h"
+#include <mutex>
+#include <memory>
+
+namespace ParkObjects
+{
+    using namespace ParkCore;
+    struct PendingEdit { Edit value;bool received=false;std::vector<bool> parts; };
+    struct PendingDrop { Drop value;bool received=false; };
+    struct Transaction { uint32_t request=0,map=0,instance=0,started=0;size_t parts=0;std::vector<PendingEdit> edits;std::vector<PendingDrop> drops; };
+    struct Client { uint64_t owner=0;uint32_t map=0,instance=0,lastSync=0;bool ready=false;std::unique_ptr<Transaction> transaction; };
+    static std::recursive_mutex s_lock;
+    static Store s_store;
+    static std::unordered_map<WorldSession*,Client> s_clients;
+    static uint32_t s_snapshot=0;
+    static uint64_t Token(WorldSession* session) { return uint64_t(reinterpret_cast<uintptr_t>(session)); }
+    static void Send(Player* player,Bytes const& bytes)
+    {
+        std::string text=Encode(bytes);WorldPacket packet;
+        ChatHandler::BuildChatPacket(packet,CHAT_MSG_WHISPER,text.c_str(),LANG_ADDON,CHAT_TAG_NONE,player->GetObjectGuid(),nullptr,player->GetObjectGuid());
+        player->GetSession()->SendPacket(&packet);
+    }
+    static void Reject(Player* player,uint32_t request,uint8_t reason) {Bytes bytes{VERSION,9};U32(bytes,request);bytes.push_back(reason);Send(player,bytes);}
+    static void Broadcast(uint32_t map,uint32_t instance,Bytes const& bytes)
+    {
+        for(auto const& client:s_clients)
+        {
+            Player* player=client.first->GetPlayer();
+            if(client.second.ready && player && player->IsInWorld() && player->GetMapId()==map && player->GetInstanceId()==instance)Send(player,bytes);
+        }
+    }
+    static void SendObject(Player* player,ParkCore::Object const& object,uint32_t request,uint16_t slot=0)
+    {
+        Send(player,ObjectMessage(object,request,slot));for(uint16_t index=0;index<object.parts.size();++index)Send(player,PartMessage(object,index));
+    }
+    static void Changes(uint32_t map,uint32_t instance,uint64_t owner,uint32_t request,std::vector<ParkCore::Object> const& changed,std::vector<ParkCore::Object> const& removed)
+    {
+        Bytes begin{VERSION,17};U32(begin,request);U64(begin,owner);U16(begin,uint16_t(changed.size()));U16(begin,uint16_t(removed.size()));Broadcast(map,instance,begin);
+        for(auto const& object:removed) {Bytes bytes{VERSION,7};U32(bytes,request);U64(bytes,object.owner);U32(bytes,object.id);Broadcast(map,instance,bytes);}
+        for(uint16_t slot=0;slot<changed.size();++slot)
+        {
+            auto const& object=changed[slot];Broadcast(map,instance,ObjectMessage(object,request,slot));
+            for(uint16_t index=0;index<object.parts.size();++index)Broadcast(map,instance,PartMessage(object,index));
+        }
+        Bytes end{VERSION,19};U32(end,request);U64(end,owner);Broadcast(map,instance,end);
+    }
+    static void Snapshot(Player* player,Client& client)
+    {
+        client.map=player->GetMapId();client.instance=player->GetInstanceId();client.lastSync=WorldTimer::getMSTime();
+        auto objects=s_store.Snapshot(client.map,client.instance);uint32_t snapshot=++s_snapshot;
+        Bytes begin{VERSION,4};U32(begin,snapshot);U32(begin,client.map);U32(begin,client.instance);U16(begin,uint16_t(objects.size()));Send(player,begin);
+        for(auto const& object:objects)SendObject(player,object,0);
+        Bytes end{VERSION,6};U32(end,snapshot);Send(player,end);client.ready=true;
+    }
+    static bool Stage(Player* player,Client& client,Request const& request)
+    {
+        if(request.kind==12)
+        {
+            if(client.transaction)Reject(player,client.transaction->request,6);
+            client.transaction.reset(new Transaction);auto& tx=*client.transaction;
+            tx.request=request.request;tx.map=player->GetMapId();tx.instance=player->GetInstanceId();tx.started=WorldTimer::getMSTime();tx.edits.resize(request.edits);tx.drops.resize(request.drops);return true;
+        }
+        auto fail=[&](uint8_t reason) {Reject(player,request.request,reason);client.transaction.reset();return true;};
+        if(!client.transaction || client.transaction->request!=request.request)return fail(6);
+        auto& tx=*client.transaction;
+        if(tx.map!=player->GetMapId() || tx.instance!=player->GetInstanceId())return fail(5);
+        if(request.kind==13)
+        {
+            if(request.slot>=tx.edits.size())return fail(1);auto& edit=tx.edits[request.slot];
+            if(edit.received)return fail(1);
+            tx.parts+=request.parts?request.parts:1;if(tx.parts>OWNER_PART_LIMIT)return fail(4);
+            edit.received=true;edit.value.id=request.id;edit.value.revision=request.revision;edit.value.model=request.model;edit.value.asset=request.asset;edit.value.pose=request.pose;edit.value.parts.resize(request.parts);edit.parts.resize(request.parts,false);return true;
+        }
+        if(request.kind==14)
+        {
+            if(request.slot>=tx.edits.size())return fail(1);auto& edit=tx.edits[request.slot];
+            if(!edit.received || request.index>=edit.parts.size() || edit.parts[request.index])return fail(1);
+            edit.parts[request.index]=true;edit.value.parts[request.index]=request.part;return true;
+        }
+        if(request.kind==15)
+        {
+            if(request.slot>=tx.drops.size() || tx.drops[request.slot].received)return fail(1);
+            tx.drops[request.slot].received=true;tx.drops[request.slot].value={request.id,request.revision};return true;
+        }
+        std::vector<Edit> edits;std::vector<Drop> drops;
+        for(auto const& edit:tx.edits) {if(!edit.received)return fail(1);for(bool received:edit.parts)if(!received)return fail(1);edits.push_back(edit.value);}
+        for(auto const& drop:tx.drops) {if(!drop.received)return fail(1);drops.push_back(drop.value);}
+        std::vector<ParkCore::Object> changed,removed;
+        uint8_t reason=s_store.Apply(client.owner,Token(player->GetSession()),tx.map,tx.instance,edits,drops,changed,removed);
+        uint32_t map=tx.map,instance=tx.instance;client.transaction.reset();
+        if(reason) {Reject(player,request.request,reason);return true;}
+        Changes(map,instance,client.owner,request.request,changed,removed);return true;
+    }
+    void Advertise(Player* player) { Bytes bytes{VERSION,11};U32(bytes,CATALOG);Send(player,bytes); }
+    void Toggle(Player* player) { Send(player,Bytes{VERSION,10}); }
+    bool Handle(Player* player,std::string const& text)
+    {
+        if(text.compare(0,sizeof(PREFIX)-1,PREFIX)!=0)return false;
+        Request request;if(!Parse(text,request))return true;
+        std::lock_guard<std::recursive_mutex> guard(s_lock);WorldSession* session=player->GetSession();
+        auto& client=s_clients[session];client.owner=player->GetObjectGuid().GetRawValue();
+        if(!player->IsInWorld())return true;
+        if(request.kind==0 || request.kind==3) {if(!client.ready || WorldTimer::getMSTimeDiff(client.lastSync,WorldTimer::getMSTime())>=250)Snapshot(player,client);return true;}
+        if(!client.ready)return true;
+        if(request.kind>=12)return Stage(player,client,request);
+        ParkCore::Object object;
+        uint8_t reason=request.kind==1?s_store.Put(client.owner,Token(session),player->GetMapId(),player->GetInstanceId(),request,object):s_store.Delete(client.owner,Token(session),request,object);
+        if(reason) {Reject(player,request.request,reason);return true;}
+        if(request.kind==1)Changes(object.map,object.instance,client.owner,request.request,{object},{});
+        else Changes(object.map,object.instance,client.owner,request.request,{}, {object});
+        return true;
+    }
+    void RemoveSession(WorldSession* session)
+    {
+        std::lock_guard<std::recursive_mutex> guard(s_lock);auto removed=s_store.RemoveSession(Token(session));s_clients.erase(session);
+        for(auto const& object:removed) {Bytes bytes{VERSION,7};U32(bytes,0);U64(bytes,object.owner);U32(bytes,object.id);Broadcast(object.map,object.instance,bytes);}
+    }
+    void Update()
+    {
+        std::lock_guard<std::recursive_mutex> guard(s_lock);
+        for(auto& item:s_clients)
+        {
+            Player* player=item.first->GetPlayer();auto& client=item.second;
+            if(client.transaction && WorldTimer::getMSTimeDiff(client.transaction->started,WorldTimer::getMSTime())>5000) {if(player)Reject(player,client.transaction->request,6);client.transaction.reset();}
+            if(player && player->IsInWorld() && (client.map!=player->GetMapId() || client.instance!=player->GetInstanceId())) {if(client.transaction) {Reject(player,client.transaction->request,5);client.transaction.reset();}Snapshot(player,client);}
+        }
+    }
+}
