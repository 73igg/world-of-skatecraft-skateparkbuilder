diff --git a/src/game/SkateFlag.cpp b/src/game/SkateFlag.cpp
new file mode 100644
index 00000000..8a07fcdf
--- /dev/null
+++ b/src/game/SkateFlag.cpp
@@ -0,0 +1,101 @@
+#include "SkateFlag.h"
+#include "SkateFlagCore.h"
+#include "Skatecraft.h"
+#include "Player.h"
+#include "Map.h"
+#include "MapManager.h"
+#include "Database/DBCStores.h"
+#include "WorldSession.h"
+#include "Chat.h"
+#include "Timer.h"
+#include <mutex>
+#include <unordered_map>
+
+namespace SkateFlag {
+    using SkateFlagCore::Flag;
+    static std::recursive_mutex s_lock;
+    static bool s_ready=false;
+    static std::unordered_map<uint32,uint32> s_lastAction;
+
+    static void Send(Player* player,std::string const& body) {
+        std::string text=SkateFlagCore::PREFIX+body;WorldPacket packet;
+        ChatHandler::BuildChatPacket(packet,CHAT_MSG_WHISPER,text.c_str(),LANG_ADDON,CHAT_TAG_NONE,
+            player->GetObjectGuid(),nullptr,player->GetObjectGuid());
+        player->GetSession()->SendPacket(&packet);
+    }
+    static void Reject(Player* player,uint32 request,uint8 reason,char const* notice) {
+        Send(player,"E\t"+std::to_string(request)+"\t"+std::to_string(reason));
+        if(notice)ChatHandler(player).SendSysMessage(notice);
+    }
+    static Flag Load(Player* player) {
+        Flag f;
+        if(s_ready)if(auto result=CharacterDatabase.PQuery("SELECT revision,map,instance,zone,x,y,z,facing FROM character_skatecraft_flag WHERE guid=%u",player->GetGUIDLow())) {
+            Field* row=result->Fetch();f.revision=row[0].GetUInt64();f.map=row[1].GetUInt32();f.instance=row[2].GetUInt32();f.zone=row[3].GetUInt32();
+            f.position={row[4].GetFloat(),row[5].GetFloat(),row[6].GetFloat()};f.facing=row[7].GetFloat();
+            if(!SkateFlagCore::Valid(f))f=Flag{};
+        }
+        return f;
+    }
+    static void Snapshot(Player* player,uint32 request) {
+        Flag f=Load(player);Send(player,"F\t"+std::to_string(request)+"\t"+(f.revision?SkateFlagCore::Fields(f):"0"));
+    }
+    void InitializeStorage() {
+        std::lock_guard<std::recursive_mutex> lock(s_lock);
+        s_ready=CharacterDatabase.DirectExecute("CREATE TABLE IF NOT EXISTS character_skatecraft_flag ("
+            "guid INT UNSIGNED NOT NULL PRIMARY KEY,revision BIGINT UNSIGNED NOT NULL,"
+            "map INT UNSIGNED NOT NULL,instance INT UNSIGNED NOT NULL,zone INT UNSIGNED NOT NULL,"
+            "x DOUBLE NOT NULL,y DOUBLE NOT NULL,z DOUBLE NOT NULL,facing DOUBLE NOT NULL)");
+        if(!s_ready)sLog.Out(LOG_BASIC,LOG_LVL_ERROR,"Skatecraft: unable to initialize persistent return flags.");
+    }
+    void OnLogin(Player* player) {std::lock_guard<std::recursive_mutex> lock(s_lock);Snapshot(player,0);}
+    void OnDelete(uint32 guid) {
+        std::lock_guard<std::recursive_mutex> lock(s_lock);
+        if(s_ready)CharacterDatabase.PExecute("DELETE FROM character_skatecraft_flag WHERE guid=%u",guid);
+        s_lastAction.erase(guid);
+    }
+    bool Handle(Player* player,std::string const& message) {
+        if(message.compare(0,10,"SKATEFLAG\t")!=0)return false;
+        std::lock_guard<std::recursive_mutex> lock(s_lock);
+        SkateFlagCore::Request request;
+        if(!SkateFlagCore::Decode(message,request)) {Reject(player,0,1,nullptr);return true;}
+        if(!s_ready) {Reject(player,request.request,8,"Saved skate flags are currently unavailable.");return true;}
+        if(request.kind=='H') {Snapshot(player,0);return true;}
+        if(!player->IsInWorld()||!player->IsAlive()||!player->HasAura(Skatecraft::SPELL_SUMMON_SKATEBOARD)
+            ||player->IsBeingTeleported()||player->GetTransport()) {
+            Reject(player,request.request,2,"Use your flag while you are in Skate mode.");return true;
+        }
+        uint32 now=WorldTimer::getMSTime();uint32& last=s_lastAction[player->GetGUIDLow()];
+        if(last&&WorldTimer::getMSTimeDiff(last,now)<300) {Reject(player,request.request,3,"Wait a moment before using the flag again.");return true;}
+        last=now;
+        if(request.kind=='S') {
+            if(!MaNGOS::IsValidMapCoord(request.position[0],request.position[1],request.position[2],request.facing)
+                ||player->GetDistance(request.position[0],request.position[1],request.position[2])>2.f) {
+                Reject(player,request.request,4,"Your position changed before the flag could be saved. Try again.");return true;
+            }
+            Flag before=Load(player);
+            if(before.revision==UINT64_MAX) {Reject(player,request.request,8,"Your flag could not be saved.");return true;}
+            if(!CharacterDatabase.DirectPExecute("INSERT INTO character_skatecraft_flag (guid,revision,map,instance,zone,x,y,z,facing) "
+                "VALUES (%u,%llu,%u,%u,%u,%.9g,%.9g,%.9g,%.9g) ON DUPLICATE KEY UPDATE revision=revision+1,"
+                "map=VALUES(map),instance=VALUES(instance),zone=VALUES(zone),x=VALUES(x),y=VALUES(y),z=VALUES(z),facing=VALUES(facing)",
+                player->GetGUIDLow(),static_cast<unsigned long long>(before.revision+1),player->GetMapId(),player->GetInstanceId(),player->GetZoneId(),
+                double(request.position[0]),double(request.position[1]),double(request.position[2]),double(request.facing))) {
+                Reject(player,request.request,8,"Your flag could not be saved. The previous flag is still kept.");return true;
+            }
+            Snapshot(player,request.request);ChatHandler(player).SendSysMessage("Skate flag saved. Tap Select to return holding your board.");return true;
+        }
+        Flag flag=Load(player);
+        if(!flag.revision) {Reject(player,request.request,6,"Hold Select to place a skate flag first.");return true;}
+        if(flag.revision!=request.revision) {Snapshot(player,0);Reject(player,request.request,5,"Your saved flag changed. Try returning again.");return true;}
+        if(flag.instance && (flag.map!=player->GetMapId()||flag.instance!=player->GetInstanceId())) {
+            Reject(player,request.request,7,"That flag is inside an instance you are not currently in. Its position is still saved.");return true;
+        }
+        if(!sMapStorage.LookupEntry<MapEntry>(flag.map)||!MaNGOS::IsValidMapCoord(flag.position[0],flag.position[1],flag.position[2],flag.facing)) {
+            Reject(player,request.request,7,"The saved flag destination is unavailable. Its position is still saved.");return true;
+        }
+        bool seamless=flag.map==player->GetMapId()&&flag.instance==player->GetInstanceId()&&flag.zone==player->GetZoneId();
+        Send(player,"T\t"+std::to_string(request.request)+"\t"+(seamless?"1\t":"0\t")+SkateFlagCore::Fields(flag));
+        if(!player->TeleportTo(flag.map,flag.position[0],flag.position[1],flag.position[2],flag.facing))
+            Reject(player,request.request,7,"Unable to return to that flag right now. Its position is still saved.");
+        return true;
+    }
+}
